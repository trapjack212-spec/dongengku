# DongengKu — copy to `.env` and fill in after creating your Firebase project.
# NEVER commit a real `.env` (it is git-ignored). Alternatively paste the
# same values directly into src/firebase-config.js.
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
# reCAPTCHA v3 site key for App Check (Firebase console > App Check > Apps).
VITE_RECAPTCHA_V3_SITE_KEY=YOUR_RECAPTCHA_V3_SITE_KEY
# Set to "true" to point Auth/Firestore at the local emulators.
VITE_USE_EMULATOR=false
